{
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "app-store-review@app-store-review": true
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay -v 0.1 .claude/sounds/finish.mp3 &",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
