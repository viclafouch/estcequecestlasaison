{
  "name": "estcequecestlasaison",
  "private": true,
  "description": "Monorepo for estcequecestlasaison.fr - Seasonal fruits and vegetables in France",
  "keywords": [
    "france",
    "fruits",
    "seasonal",
    "seasonality",
    "vegetables"
  ],
  "homepage": "https://estcequecestlasaison.fr",
  "bugs": {
    "url": "https://github.com/viclafouch/estcequecestlasaison/issues"
  },
  "license": "UNLICENSED",
  "author": "Victor de la Fouchardiere",
  "repository": {
    "type": "git",
    "url": "https://github.com/viclafouch/estcequecestlasaison.git"
  },
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @estcequecestlasaison/web dev",
    "build": "pnpm --filter @estcequecestlasaison/web build",
    "start": "pnpm --filter @estcequecestlasaison/web start",
    "lint": "tsc -p tsconfig.json && oxlint scripts/ && pnpm -r lint",
    "lint:fix": "tsc -p tsconfig.json && oxlint --fix scripts/ && pnpm -r lint:fix && oxfmt",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "prepare": "husky",
    "generate-images": "npx tsx --env-file=.env.local scripts/generate-images.ts",
    "optimize-images": "npx tsx scripts/optimize-images.ts",
    "generate-og": "npx tsx scripts/generate-og-images.ts"
  },
  "dependencies": {
    "@tanstack/ai": "^0.3.0",
    "@tanstack/ai-gemini": "^0.3.2"
  },
  "devDependencies": {
    "@viclafouch/oxc-config": "1.0.0-alpha.4",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.42.0",
    "oxlint": "^1.57.0",
    "satori": "^0.19.1",
    "sharp": "^0.34.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@10.30.0+sha512.2b5753de015d480eeb88f5b5b61e0051f05b4301808a82ec8b840c9d2adf7748eb352c83f5c1593ca703ff1017295bc3fdd3119abb9686efc96b9fcb18200937",
  "pnpm": {
    "overrides": {
      "dnssd-advertise": "1.1.3"
    }
  }
}
